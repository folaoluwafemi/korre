{
  "name": "korre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"pnpm --filter @korre/web dev\" \"pnpm --filter @korre/api dev\"",
    "dev:realtime": "pnpm --filter @korre/realtime dev",
    "typecheck": "pnpm -r --sort typecheck && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint apps games packages tests --max-warnings=0 && prettier --check apps games packages tests",
    "test": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "pnpm -r --sort build",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write apps games packages tests"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@korre/counterball": "workspace:*",
    "@korre/game-protocol": "workspace:*",
    "@korre/game-sdk": "workspace:*",
    "@korre/identity-client": "workspace:*",
    "@korre/ui": "workspace:*",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "concurrently": "10.0.6",
    "eslint": "10.11.0",
    "globals": "17.5.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.2",
    "wrangler": "4.149.0"
  }
}
