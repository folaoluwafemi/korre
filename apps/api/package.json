{
  "name": "@korre/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "test": "vitest run --root ../.. --config vitest.config.ts apps/api/src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@korre/game-protocol": "workspace:*",
    "hono": "4.13.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.15.6",
    "tsx": "4.21.0"
  }
}
